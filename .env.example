# =========================================================
# AI Mail Assistant — Environment Variables
# Copy relevant sections to backend/.env and frontend/.env.local
# NEVER commit real values. NEVER expose secret keys to the frontend.
# =========================================================

# ---------------------------------------------------------
# BACKEND (backend/.env) — server-side only, never sent to browser
# ---------------------------------------------------------

# App
ENVIRONMENT=development                 # development | staging | production
APP_SECRET_KEY=replace-with-a-long-random-string   # used to sign internal tokens
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# Supabase (Postgres + Auth)
SUPABASE_URL=https://iubysiptuzamazvmrwpd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key   # secret, backend only
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret       # used to verify user JWTs

# Google OAuth (Gmail API)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret     # secret, backend only
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send

# Token encryption (for storing Gmail OAuth tokens at rest)
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-fernet-key

# Gmail push notifications (Module 3) — set up a Google Cloud Pub/Sub topic
# that Gmail publishes to, and a push subscription pointing at
# {BACKEND_URL}/api/v1/gmail/webhook with OIDC auth enabled.
GOOGLE_PUBSUB_TOPIC=projects/YOUR_GCP_PROJECT/topics/gmail-push
GOOGLE_PUBSUB_AUDIENCE=http://localhost:8000/api/v1/gmail/webhook
GOOGLE_PUBSUB_SERVICE_ACCOUNT=replace-with-pubsub-push-service-account-email
WATCH_RENEWAL_DAYS=6

# OpenAI (used starting Module 4)
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o

# Redis / Celery (used starting Module 3)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------
# FRONTEND (frontend/.env.local) — NEXT_PUBLIC_* is exposed to the browser.
# Only put PUBLIC, non-secret values behind NEXT_PUBLIC_*.
# ---------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://iubysiptuzamazvmrwpd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key   # public anon key, safe for browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
